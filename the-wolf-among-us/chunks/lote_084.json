"k": "22824",
"who": "BEAUTY",
"ctx": "Fables104/env_beautybeastapt",
"en": "It wasn't my first choice of workplace."
},
{
"k": "22825",
"who": "BIGBY",
"ctx": "Fables104/env_beautybeastapt",
