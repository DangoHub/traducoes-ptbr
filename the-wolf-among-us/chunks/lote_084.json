{
"k": "22769",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Clear your debt?"
},
{
"k": "22770",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Because I want to help."
},
{
"k": "22771",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "You wan't me to kill him?"
},
{
"k": "22772",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Lucky Pawn"
},
{
"k": "22773",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Butcher Shop"
},
{
"k": "22774",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "If you're honest I'll protect you."
},
{
"k": "22775",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "I have no time for this."
},
{
"k": "22776",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Did you deliver to the Crooked Man?"
},
{
"k": "22777",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "You needed THIS work?"
},
{
"k": "22778",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Fuck. Off."
},
{
"k": "22779",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "I don't need to."
},
{
"k": "22780",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Probably not."
},
{
"k": "22781",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "I won't mention you."
},
{
"k": "22782",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "I'll have to be ready."
},
{
"k": "22783",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Hope the first place is enough."
