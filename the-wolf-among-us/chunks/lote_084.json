"k": "22763",
"who": "BEAUTY",
"ctx": "Fables104/env_beautybeastapt",
"en": "None of us should."
},
{
"k": "22764",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Everybody's gotta work."
},
{
"k": "22765",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "I wish it were easier."
},
{
"k": "22766",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "You made your problems."
},
{
"k": "22767",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "You don't have money to spend."
