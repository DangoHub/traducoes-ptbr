},
{
"k": "22838",
"who": "BIGBY",
"ctx": "Fables104/env_beautybeastapt",
"en": "{normalb}I gotta say, your place... It looks, uh... {confuseda}[judgmental]expensive."
},
{
"k": "22839",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "Aren't you in debt?"
},
{
"k": "22840",
"who": "",
"ctx": "Fables104/env_beautybeastapt",
"en": "It's nice, that's all."
},
{
"k": "22841",
"who": "BIGBY",
"ctx": "Fables104/env_beautybeastapt",
"en": "{angrya}[judgmental]I thought you were having money problems."
},
{
"k": "22842",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "That's what we were going for."
},
{
"k": "22843",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "We've been going over that."
},
