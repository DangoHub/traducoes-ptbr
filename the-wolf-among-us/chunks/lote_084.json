},
{
"k": "22829",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "[offscreen, in the apartment]Who's at the door?"
},
{
"k": "22830",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "[offscreen, in the apartment]Beauty?"
},
{
"k": "22831",
"who": "BEAUTY",
"ctx": "Fables104/env_beautybeastapt",
