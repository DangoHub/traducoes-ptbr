"k": "22860",
"who": "BIGBY",
"ctx": "Fables104/env_beautybeastapt",
"en": "[concerned]Are you all right?"
},
{
"k": "22861",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "It was that monkey on the phone..."
},
{
"k": "22862",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "But yeah."
},
{
"k": "22863",
"who": "BEAST",
"ctx": "Fables104/env_beautybeastapt",
"en": "I think it's about time we talk."
},
