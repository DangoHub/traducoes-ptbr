},
{
"k": "20663",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You think this is a game?!"
},
{
"k": "20664",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Why the little girl?"
},
{
"k": "20665",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "No more bullshit."
},
{
"k": "20666",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "I'm sorry for your loss."
},
{
"k": "20667",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Please, help us catch Crane."
},
{
"k": "20668",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Tell me where Crane is!"
},
{
"k": "20669",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "I said no more bullshit!"
},
{
"k": "20670",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You're on thin ice."
},
{
"k": "20671",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Why are you protecting Crane?"
},
{
"k": "20672",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You're an accomplice to murder."
},
{
"k": "20673",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "No more lies!"
},
{
"k": "20674",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Who ARE you protecting?"
},
{
"k": "20675",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Please, Greenleaf."
},
{
"k": "20676",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "We can protect you."
},
{
"k": "20677",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Obligations trump catching a killer?"
},
{
"k": "20678",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Crane killed two women."
},
{
"k": "20679",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "What's so funny?"
},
{
"k": "20680",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "No, really, who are you working for?"
},
{
"k": "20681",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Who are WE working for, then?"
},
{
"k": "20682",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "I'm my own man."
},
{
"k": "20683",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Sounds like a crappy deal."
},
{
"k": "20684",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "What are you getting out of it?"
},
{
"k": "20685",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Can I make a counter-offer?"
},
{
"k": "20686",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "We're running out of time."
},
{
"k": "20687",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "The guard overstepped. Sorry."
},
{
"k": "20688",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "We can protect you AND Crane."
},
{
"k": "20689",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Who are we talking about?"
},
{
"k": "20690",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You should fear me more."
},
{
"k": "20691",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Let us help you!"
},
{
"k": "20692",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "That's what trials are for."
},
{
"k": "20693",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "He has plenty to answer for."
},
{
"k": "20694",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "The Pudd'n N Pie"
},
{
"k": "20695",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "The Woodsman's apartment"
},
{
"k": "20696",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Snow's right. [Destroy the tree.]"
},
{
"k": "20697",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "We can't ruin this woman's life."
},
{
"k": "20698",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "I won't waste an asset."
},
{
"k": "20699",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Snow, you aren't my boss yet."
},
{
"k": "20700",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Snow, you're just angry at Crane."
},
{
"k": "20701",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "I'm sorry.  But I'm also right."
},
{
"k": "20702",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Is this your mom?"
},
{
"k": "20703",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Was this in the homelands?"
},
{
"k": "20704",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You must be older than you look!"
},
{
"k": "20705",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You had a guest."
},
{
"k": "20706",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "You said you were asleep."
},
{
"k": "20707",
"who": "",
"ctx": "Fables103/env_greenleafapt",
"en": "Horace eats cookies?"
},
{
"k": "20708",
"who": "",
