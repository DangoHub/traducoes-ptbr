},
{
"k": "31064",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[numb]You'll find him in an old warehouse by the docks."
},
{
"k": "31065",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "Bloody Mary will take him there."
},
{
"k": "31066",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain]Look for a bright blue sign."
},
{
"k": "31067",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[disappointed]What are you doing, Georgie?"
},
{
"k": "31068",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[unsure]Sheriff…"
},
