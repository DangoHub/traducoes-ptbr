},
{
"k": "31198",
"who": "BIGBY",
"ctx": "Fables105/env_puddingnpie",
"en": "Just wait! You don't have to do this."
},
{
"k": "31199",
"who": "BIGBY",
"ctx": "Fables105/env_puddingnpie",
"en": "Stop! Don't do this."
},
{
"k": "31200",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "I can save them."
},
{
"k": "31201",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "I can do one good thing."
},
{
"k": "31202",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "I can save them myself."
},
{
"k": "31203",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
