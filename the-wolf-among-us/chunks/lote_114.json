},
{
"k": "31209",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain] Ah!"
},
{
"k": "31210",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "I'm not stickin' around for much longer."
},
{
"k": "31211",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[sad]I suppose you're right."
},
{
"k": "31212",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[a lot of pain]Stop! Fuck! Just stop!"
},
{
"k": "31213",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[heavy breathing]...least you're consistent."
},
{
"k": "31214",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "Didn't like the uniform, I guess."
},
{
"k": "31215",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[a little angry]What?"
},
{
"k": "31216",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "But did it have to be like this?"
},
{
"k": "31217",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[angry]Kill the girl, save the day. That's how I go?"
}
