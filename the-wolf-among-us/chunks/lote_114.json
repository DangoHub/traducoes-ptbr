},
{
"k": "31004",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain]She's the original, Bigby."
},
{
"k": "31005",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[groans in pain] ah!"
},
{
"k": "31006",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain]"
},
{
"k": "31007",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "That make you feel better?"
},
{
"k": "31008",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
