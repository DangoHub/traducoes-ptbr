},
{
"k": "31188",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[angry; sad]What makes you think you can just--"
},
{
"k": "31189",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[angry; sad]What am I to you?"
},
{
"k": "31190",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "I won't be your fucking puppet!"
},
{
"k": "31191",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[angry] Like it was either of yours to give up in the first place!"
},
{
"k": "31192",
"who": "VIVIAN",
"ctx": "Fables105/env_puddingnpie",
"en": "[angry; sad] Just shut up!"
},
{
"k": "31193",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
