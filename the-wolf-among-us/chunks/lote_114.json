"k": "30997",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[to himself; in pain]She always did what she wanted."
},
{
"k": "30998",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "She was too good for this."
},
{
"k": "30999",
"who": "BIGBY",
"ctx": "Fables105/env_puddingnpie",
"en": "{AngryB}[angry]Why the hell would she do that?"
},
{
"k": "31000",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "{PainA}[groans in pain]"
},
{
"k": "31001",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain; slight anger]So she ended it."
},
{
"k": "31002",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
"en": "[in pain]\"The Girl with the Ribbon\"."
},
{
"k": "31003",
"who": "PORGIE",
"ctx": "Fables105/env_puddingnpie",
