[
 {
  "k": "1",
  "cena": "Loyalty_Carcens_Mansion_Jewel_1",
  "quem": "Jenna (F)",
  "en": "Jewel! I wanted to talk to you about the idea I had for recruiting people from Carceburg."
 },
 {
  "k": "2",
  "quem": "Jewel (F)",
  "en": "That sounds nice, blue."
 },
 {
  "k": "3",
  "quem": "Jenna (F)",
  "en": "Errm... How're you feeling? Like- I mean ever since..."
 },
 {
  "k": "4",
  "quem": "Jewel (F)",
  "en": "Ever since I gave everyone away?"
 },
 {
  "k": "5",
  "quem": "Jenna (F)",
  "en": "That's not what I meant!"
 },
 {
  "k": "6",
  "quem": "Jewel (F)",
  "en": "But that's what happened, isn't it? I couldn't just keep my head down and then..."
 },
 {
  "k": "7",
  "quem": "Jewel (F)",
  "en": "She..."
 },
 {
  "k": "8",
  "quem": "Jewel (F)",
  "en": "It was awful..."
 },
 {
  "k": "9",
  "quem": "Jewel (F)",
  "en": "I'm so sorry, Jenna..."
 },
 {
  "k": "10",
  "quem": "Jenna (F)",
  "en": "Hey... It's alright."
 },
 {
  "k": "11",
  "quem": "Jewel (F)",
  "en": "No... No, it's not. This is all my fault. You had Karen back and then I fucked that up. I'm so sorry."
 },
 {
  "k": "12",
  "quem": "Jenna (F)",
  "en": "I..."
 },
 {
  "k": "13",
  "quem": "Jenna (F)",
  "en": "It's... It's fine. At least the beds are nicer here."
 },
 {
  "k": "14",
  "quem": "Jewel (F)",
  "en": "Still cracking jokes?"
 },
 {
  "k": "15",
  "quem": "Jenna (F)",
  "en": "Sorry, I didn't mean to..."
 },
 {
  "k": "16",
  "quem": "Jewel (F)",
  "en": "No, it's okay."
 },
 {
  "k": "17",
  "quem": "Jenna (F)",
  "en": "Okay..."
 },
 {
  "k": "18",
  "quem": "Jewel (F)",
  "en": "Back when she had me and was talking to you in the cave base... She said I begged for more..."
 },
 {
  "k": "19",
  "quem": "Jenna (F)",
  "en": "I know you didn't. It's okay."
 },
 {
  "k": "20",
  "quem": "Jewel (F)",
  "en": "Y-Yeah... I..."
 },
 {
  "k": "21",
  "quem": "Jewel (F)",
  "en": "I uhm... I did... I begged... I fucking begged... I told her everything..."
 },
 {
  "k": "22",
  "quem": "Jenna (F)",
  "en": "It wasn't your fault."
 },
 {
  "k": "23",
  "quem": "Jewel (F)",
  "en": "It sure feels like it! I see how everyone looks at me. \"Oh, there's the slut that sold us out.\""
 },
 {
  "k": "24",
  "quem": "Jenna (F)",
  "en": "I don't think that."
 },
 {
  "k": "25",
  "quem": "Jewel (F)",
  "en": "Well maybe you should."
 },
 {
  "k": "26",
  "quem": "Jenna (F)",
  "en": "Jewel..."
 },
 {
  "k": "27",
  "quem": "Jewel (F)",
  "en": "I need to be alone."
 },
 {
  "k": "28",
  "quem": "Jenna (F)",
  "en": "You don't have to be al-"
 },
 {
  "k": "29",
  "quem": "Jewel (F)",
  "en": "I'll be fine. Please."
 },
 {
  "k": "30",
  "cena": "Loyalty_Carcens_Mansion_Jewel_1_Repeat",
  "quem": "Jenna (F)",
  "en": "<i>(Maybe I shouldn't bother her...)</i>"
 },
 {
  "k": "31",
  "cena": "Loyalty_Carcens_Mansion_Jewel_2",
  "quem": "Jenna (F)",
  "en": "Hey Jewel."
 },
 {
  "k": "32",
  "quem": "Jewel (F)",
  "en": "Hi, blue. Sorry for earlier. It's been getting a little harder to keep on a smile."
 },
 {
  "k": "33",
  "quem": "Jenna (F)",
  "en": "You don't have to feel like you need to smile all the time."
 },
 {
  "k": "34",
  "quem": "Jewel (F)",
  "en": "Yeah, well... What did you want to talk about?"
 },
 {
  "k": "35",
  "quem": "Jenna (F)",
  "en": "Well, erm... I was just thinking that maybe we could recruit people by getting you to do a big dance or something like that, but if you're not feelin-"
 },
 {
  "k": "36",
  "quem": "Jewel (F)",
  "en": "Sounds good!"
 },
 {
  "k": "37",
  "quem": "Jenna (F)",
  "en": "Uh... Are you sure?"
 },
 {
  "k": "38",
  "quem": "Jewel (F)",
  "en": "Yeah, of course."
 },
 {
  "k": "39",
  "quem": "Jenna (F)",
  "en": "Alright then... Let's uh... head down to the bar then."
 },
 {
  "k": "40",
  "cena": "Loyalty_Carcens_Slums_Rats_1",
  "quem": "Jenna (F)",
  "en": "You've got something that we need. We know you've been stealing from the bar and we need some of those supplies back."
 },
 {
  "k": "41",
  "quem": "Lumber Rat Ray (M)",
  "en": "Tha' be so, eh? An' why shoul' me an' the boys (an' girls) be listenin' t' ye, ye wee tot?"
 },
 {
  "k": "42",
  "quem": "Jenna (F)",
  "en": "Because we're not your enemies. The ones you should be stealing from are up in that big ass tower."
 },
 {
  "k": "43",
  "quem": "Lumber Rat Ray (M)",
  "en": "Yea? Ye' think ye' can just walk up in 'ere an' tell us wha' we can an' can't do?"
 },
 {
  "k": "44",
  "quem": "Jenna (F)",
  "en": "I do, actually."
 },
 {
  "k": "45",
  "quem": "Lumber Rat Ray (M)",
  "en": "Boys (an' girls)! Come 'ere an' show this wee slag wha' we do t' them tha' try t' tell us wha' t' do."
 },
 {
  "k": "46",
  "cena": "Loyalty_Carcens_Slums_Rats_2",
  "quem": "Jenna (F)",
  "en": "Ugh. This is such a waste of time."
 },
 {
  "k": "47",
  "quem": "Jenna (F)",
  "en": "Come on. It's their fault we're all like this. We have a common goal."
 },
 {
  "k": "48",
  "quem": "Lumber Rat Ray (M)",
  "en": "Ain't nothin' common, missy. We do wha' we do t' survive. Ain't gonna survive goin' after th' big fish. We be stickin' t' th' wee fish."
 },
 {
  "k": "49",
  "quem": "Jenna (F)",
  "en": "And that's what you wanna do for the rest of your life?"
 },
 {
  "k": "50",
  "quem": "Jenna (F)",
  "en": "You won't even be able to do that long either once that tower is done. They're gonna take away your free will and you're just gonna sit around?"
 },
 {
  "k": "51",
  "quem": "Jenna (F)",
  "en": "Don't any of you have a dream?"
 },
 {
  "k": "52",
  "cena": "Loyalty_Carcens_Slums_Rats_3_Healslut",
  "quem": "Rat Healslut (F)",
  "en": "I have a dream... I want to be a nurse. Like... not just a slutty one."
 },
 {
  "k": "53",
  "cena": "Loyalty_Carcens_Slums_Rats_4_Squirter",
  "quem": "Rat Squirter (F)",
  "en": "I want to be a gardener... I really like flowers."
 },
 {
  "k": "54",
  "cena": "Loyalty_Carcens_Slums_Rats_5_Flogger",
  "quem": "Rat Flogger (F)",
  "en": "I like making escape rooms, just like the one I put you in!"
 },
 {
  "k": "55",
  "cena": "Loyalty_Carcens_Slums_Rats_6_Shredder",
  "quem": "Rat Shredder (M)",
  "en": "... Like clothes... Want make clothes... Not just rip them... Maybe rip some of  them after..."
 },
 {
  "k": "56",
  "cena": "Loyalty_Carcens_Slums_Rats_7",
  "quem": "Lumber Rat Ray (M)",
  "en": "W- I... I didn' know tha's how th' boys (and girls) felt..."
 },
 {
  "k": "57",
  "quem": "Jenna (F)",
  "en": "What about you, Ray? What's your dream?"
 },
 {
  "k": "58",
  "quem": "Lumber Rat Ray (M)",
  "en": "... I jus' wan' th' boys (an' girls) t' be happy."
 },
 {
  "k": "59",
  "quem": "Jenna (F)",
  "en": "No one's gonna be happy if we let them finish building that tower. The only way we can stop them is if we band the town together to fight."
 },
 {
  "k": "60",
  "quem": "Jenna (F)",
  "en": "We need the supplies for a big show at the bar to get attention and bring everyone together. Everyone. That includes you. Will you be there?"
 },
 {
  "k": "61",
  "quem": "Lumber Rat Ray (M)",
  "en": "... Argh... Fine... Oi, give 'em th' stuff from th' bar."
 },
 {
  "k": "62",
  "quem": "Jenna (F)",
  "en": "Thank you."
 },
 {
  "k": "63",
  "quem": "Lumber Rat Ray (M)",
  "en": "The boys (and girls) gonna help ye'. We'll clear out an' start headin' down t' yer bar."
 },
 {
  "k": "64",
  "quem": "Jenna (F)",
  "en": "Can't wait to see you there. It'll be a great show."
 },
 {
  "k": "65",
  "quem": "Jewel (F)",
  "en": "Heh..."
 },
 {
  "k": "66",
  "cena": "Loyalty_Carcens_Wildfire_0",
  "quem": "Wildfire (F)",
  "en": "Get your fucking hands off of me!"
 },
 {
  "k": "67",
  "quem": "Pyra (F)",
  "en": "I found our little flame~ Oh, and half the town is missing~"
 },
 {
  "k": "68",
  "quem": "Leath (F)",
  "en": "So it would seem. Hello Wildfire."
 },
 {
  "k": "69",
  "quem": "Leath (F)",
  "en": "Seems like she lost her manners while she was out with her girlfriend."
 },
 {
  "k": "70",
  "quem": "Wildfire (F)",
  "en": "She's not my girlfriend!"
 },
 {
  "k": "71",
  "quem": "Leath (F)",
  "en": "Take your mask off."
 },
 {
  "k": "72",
  "quem": "Pyra (F)",
  "en": "You heard her, matchbox~ Off with it~"
 },
 {
  "k": "73",
  "quem": "Karen (F)",
  "en": "Fine!"
 },
 {
  "k": "74",
  "quem": "Leath (F)",
  "en": "Much better."
 },
 {
  "k": "75",
  "quem": "Leath (F)",
  "en": "Now then... If she's not your girlfriend, then why... the fuck... is she still alive? Where did the town disappear to? Right under your nose I might add..."
 },
 {
  "k": "76",
  "quem": "Karen (F)",
  "en": "What the fuck is that supposed to mean?! Pyra was there too! She's as much at fault as I am!"
 },
 {
  "k": "77",
  "quem": "Pyra (F)",
  "en": "I wouldn't have been there if you did your job, matchbox~"
 },
 {
  "k": "78",
  "quem": "Leath (F)",
  "en": "You were with your little girlfriend and she's still around. You let her take you away. You made us all look weak. Now why is that?"
 },
 {
  "k": "79",
  "quem": "Karen (F)",
  "en": "I tried to take her down..."
 },
 {
  "k": "80",
  "quem": "Pyra (F)",
  "en": "Tried~? That's not true~ I shaped you into a killing machine, little matchbox~"
 },
 {
  "k": "81",
  "quem": "Leath (F)",
  "en": "Which means that the only reason your target is still alive is that you're on her side. Are you on her side?"
 },
 {
  "k": "82",
  "quem": "Karen (F)",
  "en": "Wh- No..."
 },
 {
  "k": "83",
  "quem": "Karen (F)",
  "en": "I'm not on her side! I HATE HER!"
 },
 {
  "k": "84",
  "quem": "Leath (F)",
  "en": "You still love her."
 },
 {
  "k": "85",
  "quem": "Karen (F)",
  "en": "No..."
 },
 {
  "k": "86",
  "quem": "Pyra (F)",
  "en": "I can squeeze that out of her~"
 },
 {
  "k": "87",
  "quem": "Karen (F)",
  "en": "No... No, I tried..."
 },
 {
  "k": "88",
  "quem": "Leath (F)",
  "en": "No, you didn't. You don't have the rage for it. Fix that, Agent Pyra."
 },
 {
  "k": "89",
  "quem": "Pyra (F)",
  "en": "Mmm~ Been a while since I gave you the angry juice, matchbox~  Bet you wish you got the horny treatment like everyone else, hm~?"
 },
 {
  "k": "90",
  "quem": "Karen (F)",
  "en": "W-Wait. Wait, wait. P-Please, I can take her. Just... Just give me another chance."
 },
 {
  "k": "91",
  "quem": "Leath (F)",
  "en": "You will. After your conditioning."
 },
 {
  "k": "92",
  "quem": "Karen (F)",
  "en": "NO! NO!"
 },
 {
  "k": "93",
  "quem": "Karen (F)",
  "en": "YOU WANT ANGRY?! I'M ANGRY!"
 },
 {
  "k": "94",
  "quem": "Pyra (F)",
  "en": "No you're not~ Not yet, little matchbox~ You're just a little ember~ We want an inferno~"
 },
 {
  "k": "95",
  "quem": "Karen (F)",
  "en": "N-No... Not again..."
 },
 {
  "k": "96",
  "quem": "Leath (F)",
  "en": "Take her away. Get it done."
 },
 {
  "k": "97",
  "quem": "Pyra (F)",
  "en": "Yes, mistress~"
 },
 {
  "k": "98",
  "cena": "Loyalty_Fiends_TalkToLady",
  "quem": "Jenna (F)",
  "en": "I just wanted to talk to you abou-"
 },
 {
  "k": "99",
  "quem": "Rida (F)",
  "en": "Rida want Gob back."
 },
 {
  "k": "100",
  "quem": "Lady (F)",
  "en": "Gob...?"
 },
 {
  "k": "101",
  "quem": "Lady (F)",
  "en": "What the hell is she talking about?"
 },
 {
  "k": "102",
  "quem": "Jenna (F)",
  "en": "Uh... well-"
 },
 {
  "k": "103",
  "quem": "Rida (F)",
  "en": "No talk to Carcen. Talk to Rida."
 },
 {
  "k": "104",
  "quem": "Rida (F)",
  "en": "Gob is tribe. Rida tribe. Give Gob back."
 },
 {
  "k": "105",
  "quem": "Lady (F)",
  "en": "You mean that fiend we found? From that tribe of yours that kidnaps our people? You want me to free him just like that? No."
 },
 {
  "k": "106",
  "quem": "Rida (F)",
  "en": "GIVE GOB BACK!"
 },
 {
  "k": "107",
  "quem": "Lady (F)",
  "en": "Go to hell."
 },
 {
  "k": "108",
  "quem": "Jenna (F)",
  "en": "Err... Lady? Maybe we shouldn't lock up people that could help us?"
 },
 {
  "k": "109",
  "quem": "Lady (F)",
  "en": "Help us? We've been having to fight off the fiends for years. I still can't believe this one has managed so long without going feral."
 },
 {
  "k": "110",
  "quem": "Rida (F)",
  "en": "Rida not animal. No talk about Rida like animal."
 },
 {
  "k": "111",
  "quem": "Jenna (F)",
  "en": "There's a whole tribe of people that hate Peitho as much as we do. If we can work with the Lumber Rats, why can't we work with Rida's tribe?"
 },
 {
  "k": "112",
  "quem": "Lady (F)",
  "en": "They're unpredictable. At least with the gang we know their motives."
 },
 {
  "k": "113",
  "quem": "Jenna (F)",
  "en": "I trust Rida. They'll follow Rida. "
 },
 {
  "k": "114",
  "quem": "Lady (F)",
  "en": "Then where are they? Why haven't they followed her?"
 },
 {
  "k": "115",
  "quem": "Rida (F)",
  "en": "Grr..."
 },
 {
  "k": "116",
  "quem": "Jenna (F)",
  "en": "There's uh... someone else leading them."
 },
 {
  "k": "117",
  "quem": "Rida (F)",
  "en": "Mina..."
 },
 {
  "k": "118",
  "quem": "Lady (F)",
  "en": "So they won't follow her. They're following this 'Mina'."
 },
 {
  "k": "119",
  "quem": "Jenna (F)",
  "en": "There's gotta be a way we can get them on our side..."
 },
 {
  "k": "120",
  "quem": "Rida (F)",
  "en": "Wrestle."
 },
 {
  "k": "121",
  "quem": "Jenna (F)",
  "en": "Eh?"
 },
 {
  "k": "122",
  "quem": "Rida (F)",
  "en": "Wrestle Mina, win, tribe follow strong."
 },
 {
  "k": "123",
  "quem": "Lady (F)",
  "en": "Ugh..."
 },
 {
  "k": "124",
  "quem": "Jenna (F)",
  "en": "Like a duel?"
 },
 {
  "k": "125",
  "quem": "Rida (F)",
  "en": "Mm... Duel. Tribe tradition. Winner is leader. Loser is exile."
 },
 {
  "k": "126",
  "quem": "Jenna (F)",
  "en": "So how are we gonna get Mina to accept a duel with you?"
 },
 {
  "k": "127",
  "quem": "Rida (F)",
  "en": "Find tribe camps. Fight. Get Mina attention."
 },
 {
  "k": "128",
  "quem": "Jenna (F)",
  "en": "Why don't we just strut up to your old tent and duel her right away?"
 },
 {
  "k": "129",
  "quem": "Rida (F)",
  "en": "Too many. Attack camps. Good plan."
 },
 {
  "k": "130",
  "quem": "Rida (F)",
  "en": "And Carcen help Rida train for wrestle."
 },
 {
  "k": "131",
  "quem": "Jenna (F)",
  "en": "You want me to wrestle you?"
 },
 {
  "k": "132",
  "quem": "Rida (F)",
  "en": "Mm."
 },
 {
  "k": "133",
  "quem": "Lady (F)",
  "en": "Ugh... If you're somehow able to convince those fiends to fight with us, fine. But you're responsible for them."
 },
 {
  "k": "134",
  "quem": "Rida (F)",
  "en": "Now give Gob back."
 },
 {
  "k": "135",
  "quem": "Lady (F)",
  "en": "Fine."
 },
 {
  "k": "136",
  "quem": "Gob (M)",
  "en": "Rida! Gob miss Rida!"
 },
 {
  "k": "137",
  "quem": "Rida (F)",
  "en": "Rida miss Gob. How Gob?"
 },
 {
  "k": "138",
  "quem": "Gob (M)",
  "en": "Gob happy now! Gob ran from tribe. Look for Rida. Mina lie. Say Rida not strong. Rida strong."
 },
 {
  "k": "139",
  "quem": "Rida (F)",
  "en": "... Gob good."
 },
 {
  "k": "140",
  "quem": "Gob (M)",
  "en": "Ah! Gob happy!"
 },
 {
  "k": "141",
  "quem": "Rida (F)",
  "en": "Rida happy."
 },
 {
  "k": "142",
  "quem": "Rida (F)",
  "en": "Gob stay here. Rida go find tribe camps with Carcen."
 },
 {
  "k": "143",
  "quem": "Gob (M)",
  "en": "Gob stay here!"
 },
 {
  "k": "144",
  "quem": "Jenna (F)",
  "en": "So... We'll go fight a tribe camp and then do some wrestling after?"
 },
 {
  "k": "145",
  "quem": "Rida (F)",
  "en": "Mm."
 },
 {
  "k": "146",
  "quem": "Jenna (F)",
  "en": "And... we're good right? I'm sorry about earlier."
 },
 {
  "k": "147",
  "quem": "Rida (F)",
  "en": "Gob okay. Rida okay."
 },
 {
  "k": "148",
  "quem": "Jenna (F)",
  "en": "Great! Let's head out then, I guess."
 },
 {
  "k": "149",
  "cena": "Loyalty_Fiends_TalkToLady_2",
  "quem": "Jenna (F)",
  "en": "We're ready now."
 },
 {
  "k": "150",
  "quem": "Lady (F)",
  "en": "Ready...? What for?"
 },
 {
  "k": "151",
  "quem": "Jenna (F)",
  "en": "To get Rida her tribe back?"
 },
 {
  "k": "152",
  "quem": "Lady (F)",
  "en": "It's still a bad idea."
 },
 {
  "k": "153",
  "quem": "Rida (F)",
  "en": "No. Good idea."
 },
 {
  "k": "154",
  "quem": "Lady (F)",
  "en": "So why are you coming to me then? I'm not going to risk any of our members for the forest fiends."
 },
 {
  "k": "155",
  "quem": "Jenna (F)",
  "en": "Oh! I'm just used to coming back to you is all. My bad."
 },
 {
  "k": "156",
  "quem": "Rida (F)",
  "en": "Rida want go now!"
 },
 {
  "k": "157",
  "quem": "Lady (F)",
  "en": "Do you even know where they are?"
 },
 {
  "k": "158",
  "quem": "Rida (F)",
  "en": "Rida lived there. Duh."
 },
 {
  "k": "159",
  "quem": "Lady (F)",
  "en": "Right..."
 },
 {
  "k": "160",
  "quem": "Floria (F)",
  "en": "Shouldn't we have some sort of plan first?"
 },
 {
  "k": "161",
  "quem": "Rida (F)",
  "en": "Yes! Plan is attack."
 },
 {
  "k": "162",
  "quem": "Jenna (F)",
  "en": "Hmm... are there some secret passages into the hub that we can use?"
 },
 {
  "k": "163",
  "quem": "Rida (F)",
  "en": "Mm! Many passages."
 },
 {
