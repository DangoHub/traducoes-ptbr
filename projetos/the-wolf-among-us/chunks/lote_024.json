{
"k": "6374",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Ask About"
},
{
"k": "6375",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Only one next to you..."
},
{
"k": "6376",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "But there's only one right next to you."
},
{
"k": "6377",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "I don't want to have to yell."
},
{
"k": "6378",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "If I sit over there, I'm gonna have to yell to talk to you. And I don't like raising my voice unless I really have to."
},
{
"k": "6379",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "You got a problem?"
