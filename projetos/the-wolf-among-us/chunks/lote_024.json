{
"k": "6392",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Sure"
},
{
"k": "6393",
"who": "HOLLY",
"ctx": "Fables101/env_trollbar",
"en": "I think they have some at the bar down the street."
