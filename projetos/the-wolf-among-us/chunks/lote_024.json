},
{
"k": "6288",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "We're done here."
},
{
"k": "6289",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "I think we're done here."
},
{
"k": "6290",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "This is a bunch of bullshit. Stop talking."
