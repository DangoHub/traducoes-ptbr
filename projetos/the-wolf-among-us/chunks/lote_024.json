"en": "You gonna order something, or you just here to bother my customers."
},
{
"k": "6384",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Customers?"
},
{
"k": "6385",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Sorry, you're busy..."
},
