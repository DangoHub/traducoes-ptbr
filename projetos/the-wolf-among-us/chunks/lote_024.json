"k": "6333",
"who": "GRENDEL",
"ctx": "Fables101/env_trollbar",
"en": "Should've walked out of here when you had the chance."
},
{
"k": "6334",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Cool heads can prevail."
},
{
"k": "6335",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
