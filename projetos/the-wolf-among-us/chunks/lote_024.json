{
"k": "6394",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "Sure."
},
{
"k": "6395",
"who": "HOLLY",
"ctx": "Fables101/env_trollbar",
"en": "Well, I don't got any anyway."
},
{
"k": "6396",
"who": "HOLLY",
"ctx": "Fables101/env_trollbar",
"en": "Cause I think they got some at the bar down the street."
},
{
"k": "6397",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "Think that's funny?"
},
