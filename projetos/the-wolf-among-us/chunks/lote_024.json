"k": "6264",
"who": "GREN",
"ctx": "Fables101/env_trollbar",
"en": "Maybe he don't want to talk to you."
},
{
"k": "6265",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "I just want to talk."
},
{
"k": "6266",
"who": "BIGBY",
"ctx": "Fables101/env_trollbar",
"en": "I just want to talk. This doesn't have to go like this."
},
{
"k": "6267",
"who": "",
"ctx": "Fables101/env_trollbar",
"en": "Don't fuck with me..."
