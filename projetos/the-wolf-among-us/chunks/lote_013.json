"ctx": "Fables101/env_bigbyapartment",
"en": "Want a mint for your pillow?"
},
{
"k": "3270",
"who": "",
"ctx": "Fables101/env_bigbyapartment",
"en": "You didn't have to come here."
},
{
"k": "3271",
