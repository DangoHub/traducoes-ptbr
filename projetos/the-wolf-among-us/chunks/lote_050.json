[
{
"k": "13183",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "What about the hoof marks on the stage?"
},
{
"k": "13184",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "This is where the dancers change for their stage bits."
},
{
"k": "13185",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "No. Cash business, off the books."
},
{
"k": "13186",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "You got a receipt that'll tell me WHEN you bought this?"
},
{
"k": "13187",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "See? I told you I was dealing with the liquor delivery, and here it is."
},
{
"k": "13188",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Use Key"
},
{
"k": "13189",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Nothing worth bothering about in there. Nobody's been in it since we lost the key about probably ten years ago."
},
{
"k": "13190",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Open this drawer."
},
{
"k": "13191",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Break Open"
},
{
"k": "13192",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Aw, fucking hell."
},
{
"k": "13193",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Ask Georgie"
},
{
"k": "13194",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Somebody broke into this. Was it you?"
},
{
"k": "13195",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[sarcastic]Are you sure it wasn't you?"
},
{
"k": "13196",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Why the fuck would I do that?"
},
{
"k": "13197",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Fuck if I know."
},
{
"k": "13198",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Whose is this?"
},
{
"k": "13199",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Where'd you get that?"
},
{
"k": "13200",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "From a dead woman."
},
{
"k": "13201",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Either the box is Charlotte's, or she had someone else's key."
},
{
"k": "13202",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "I don't think it's valuable, but it is old. From the Homelands I'd bet. Not what they were after, obviously."
},
{
"k": "13203",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "That'll be Faith's. Seen her wearing it around. Think it's worth anything?"
},
{
"k": "13204",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Whose purse is that?"
},
{
"k": "13205",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "The only thing I know is it's not mine."
},
{
"k": "13206",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Just curious."
},
{
"k": "13207",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "What's that, then?"
},
{
"k": "13208",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "What? Fuck, no. It couldn't really say that in there, does it?"
},
{
"k": "13209",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Lot of scribbles. Some parts are clear. Looks like a journal."
},
{
"k": "13210",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Charlotte's."
},
{
"k": "13211",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Did you have any special plans in mind for Faith?"
},
{
"k": "13212",
"who": "CHARLOTTE",
"ctx": "Fables102/env_puddinpie",
"en": "[VO] Faith has been all superior lately. She acts like she's got something better lined up."
},
{
"k": "13213",
"who": "CHARLOTTE",
"ctx": "Fables102/env_puddinpie",
"en": "[VO]My sister was a total bitch to me today. She wouldn't loan me money and I had to go C.T. Fuck her."
},
{
"k": "13214",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Where's the \"mermaid room\"?"
},
{
"k": "13215",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Never mind. I've got a pretty good idea."
},
{
"k": "13216",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "This your writing?"
},
{
"k": "13217",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "No - Vivian's. She handles booking."
},
{
"k": "13218",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "And she'll be in later."
},
{
"k": "13219",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Yeh."
},
{
"k": "13220",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[insolent]You're the detective, you figure it out!"
},
{
"k": "13221",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Just wondering why Charlotte would have the key to Faith's jewelry box."
},
{
"k": "13222",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Were Faith and Charlotte close?"
},
{
"k": "13223",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Nah, I don't think they even liked each other much. Why?"
},
{
"k": "13224",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "No, that's not it. She just looks… different."
},
{
"k": "13225",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Oh! I didn't recognize her."
},
{
"k": "13226",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "She's had the legs for ages, even before here. Uses a fake tail for the fetish crowd."
},
{
"k": "13227",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Nerissa. It is. She's been with us a long time, so, when we had it done we had her pose."
},
{
"k": "13228",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "She used to be the Little Mermaid."
},
{
"k": "13229",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Looks like the woman I met at the door."
},
{
"k": "13230",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Her name seems familiar."
},
{
"k": "13231",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "It's like she's beckoning."
},
{
"k": "13232",
"who": "GEORGE",
"ctx": "Fables102/env_puddinpie",
"en": "Aw, damn it. I was gonna open it for you."
},
{
"k": "13233",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Haha! Yeah, you've found it, sheriff. But there's a spell on it, only staff and paying clients can actually--"
},
{
"k": "13234",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Wha--"
},
{
"k": "13235",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[process through door]Sheriff! …Bugger."
},
{
"k": "13236",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Stay out!"
},
{
"k": "13237",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Right color for troll blood."
},
{
"k": "13238",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Smell Blood"
},
{
"k": "13239",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Charlotte."
},
{
"k": "13240",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "What happened to you in here?"
},
{
"k": "13241",
"who": "SNOW",
"ctx": "Fables102/env_puddinpie",
"en": "[sexy]These lips are sealed."
},
{
"k": "13242",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Porgie!"
},
{
"k": "13243",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "[covering his surprise somewhat]Detective Brannigan."
},
{
"k": "13244",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "You seem to turn up everywhere I go."
},
{
"k": "13245",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[wtf]You know each other?"
},
{
"k": "13246",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "…can talk to me, I'm not a vice cop so I'm not interested in whatever you're worried I might be interested in. I just want to ask a few questions, see if you recognize--"
},
{
"k": "13247",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "B-- Mister Wolf!"
},
{
"k": "13248",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "I was thinking the same thing"
},
{
"k": "13249",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "I was thinking the same thing."
},
{
"k": "13250",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Investigating."
},
{
"k": "13251",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Blowing off steam."
},
{
"k": "13252",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "What's it look like?"
},
{
"k": "13253",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "No offense, but you should probably leave that to professionals. There's a killer walking around."
},
{
"k": "13254",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Same as you. Looking into the case."
},
{
"k": "13255",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "I'll bet."
},
{
"k": "13256",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "I'll be careful."
},
{
"k": "13257",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "How'd you find the place?"
},
{
"k": "13258",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Miss White mentioned it once."
},
{
"k": "13259",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "A clue."
},
{
"k": "13260",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "How did you find it?"
},
{
"k": "13261",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "You know I can't tell you that. Just following a lead."
},
{
"k": "13262",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "How did YOU find it?"
},
{
"k": "13263",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "What were you up to behind the mermaid there?"
},
{
"k": "13264",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Don't!"
},
{
"k": "13265",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "[quietly]Anything you want to tell me?"
},
{
"k": "13266",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "Funny you didn't mention you'd been here."
},
{
"k": "13267",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "Well, now I know where all that black crap you had on you last night came from."
},
{
"k": "13268",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "[what do you want]What?"
},
{
"k": "13269",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Nothing."
},
{
"k": "13270",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "It's a mess."
},
{
"k": "13271",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Don't go in there."
},
{
"k": "13272",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "It's, ah, it's a mess in there."
},
{
"k": "13273",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "Don't fuck with me, Bigby."
},
{
"k": "13274",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "I wasn't here."
},
{
"k": "13275",
"who": "KELSEY",
"ctx": "Fables102/env_puddinpie",
"en": "[disappointed]Yeah."
},
{
"k": "13276",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Be careful. There's a killer walking around."
},
{
"k": "13277",
"who": "HANS",
"ctx": "Fables102/env_puddinpie",
"en": "She never even showed us the picture."
},
{
"k": "13278",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "What the fuck was that?! Who's your mundy friend?! I can't have mundys just waltzing in here any time they please!"
},
{
"k": "13279",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "She's working Charlotte's murder!"
},
{
"k": "13280",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Yeah, and she thinks you did it! You led her right to us!"
},
{
"k": "13281",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "No, Charlotte was killed here! In your little secret room right there!"
},
{
"k": "13282",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "No, what, really?"
},
{
"k": "13283",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "What am I supposed to do?"
},
{
"k": "13284",
"who": "HANS",
"ctx": "Fables102/env_puddinpie",
"en": "In there?"
},
{
"k": "13285",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Good Christ, I didn't know that."
},
{
"k": "13286",
"who": "HANS",
"ctx": "Fables102/env_puddinpie",
"en": "Boy…"
},
{
"k": "13287",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Don't play coy."
},
{
"k": "13288",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "It's a slaughterhouse in there."
},
{
"k": "13289",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Who else had access?"
},
{
"k": "13290",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "You did this."
},
{
"k": "13291",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "silence - [timeout]"
},
{
"k": "13292",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Don't play coy with me. You had to know what happened in there!"
},
{
"k": "13293",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Honestly!"
},
{
"k": "13294",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "I've been away!"
},
{
"k": "13295",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "I never go in there!"
},
{
"k": "13296",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "You gotta believe me, I didn't know a thing!"
},
{
"k": "13297",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "I don't believe you."
},
{
"k": "13298",
"who": "GEORGE",
"ctx": "Fables102/env_puddinpie",
"en": "[gut-punched]Open Arms. Up the street. Try there."
},
{
"k": "13299",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "She'll be in."
},
{
"k": "13300",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[gut-punched]Vivian! Talk to Vivian!"
},
{
"k": "13301",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[just punched in gut: coughs]"
},
{
"k": "13302",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[getting punched in gut]"
},
{
"k": "13303",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "[mean]Why?"
},
{
"k": "13304",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[punched in gut again]"
},
{
"k": "13305",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[get-punched]Clients. She'll know who Charlotte took in there last."
},
{
"k": "13306",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[gut-punched]No, but… she's there a good bit. The hotel's ours, it's convenient."
},
{
"k": "13307",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Lock up that room."
},
{
"k": "13308",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "You're closed."
},
{
"k": "13309",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Don't leave town."
},
{
"k": "13310",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "[leave now]"
},
{
"k": "13311",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Lock up that room. No one goes in there, understand?"
},
{
"k": "13312",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Sure. Piece of cake now that you've broken the door half down."
},
{
"k": "13313",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "[coughs up blood]"
},
{
"k": "13314",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Clean the fucking stage!"
},
{
"k": "13315",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Charlotte or Faith keep any personal things here?"
},
{
"k": "13316",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "I dunno. Maybe in the dressing room."
},
{
"k": "13317",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Oi! Hans! Don't just fucking sit there! Clean the fucking stage!"
},
{
"k": "13318",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "You saw him. What do you think, can I make a dancer out of that lovely side of beef?"
},
{
"k": "13319",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "I was on a toot, OK? They had a fresh shipment of Puff, and I was exploring its… psychological opportunities."
},
{
"k": "13320",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "Yes, for three days."
},
{
"k": "13321",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "Can you substantiate any of that?"
},
{
"k": "13322",
"who": "PORGIE",
"ctx": "Fables102/env_puddinpie",
"en": "The booze shipment's in the back."
},
{
"k": "13323",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Play Messages"
},
{
"k": "13324",
"who": "",
"ctx": "Fables102/env_puddinpie",
"en": "Nice place."
},
{
"k": "13325",
"who": "BIGBY",
"ctx": "Fables102/env_puddinpie",
"en": "I'm asking you where you were last night, and the night before."
},
{
"k": "13326",
