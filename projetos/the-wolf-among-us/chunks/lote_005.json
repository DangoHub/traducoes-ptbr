},
{
"k": "1324",
"who": "DEE",
"ctx": "Fables101/env_alleychase",
"en": "[out of breath, running]The fuck you want?"
},
{
"k": "1325",
"who": "WACHOWSKI",
"ctx": "Fables101/env_alleychase",
"en": "[out of breath, running]Stop!"
},
{
"k": "1326",
"who": "WACHOWSKI",
"ctx": "Fables101/env_alleychase",
"en": "[out of breath, running]Hey!"
},
{
"k": "1327",
"who": "WACHOWSKI",
"ctx": "Fables101/env_alleychase",
