{
"k": "1353",
"who": "",
"ctx": "Fables101/env_alleychase",
"en": "You're coming with me."
},
{
"k": "1354",
"who": "BIGBY",
"ctx": "Fables101/env_alleychase",
"en": "[pickup4] [intense] Then who did?"
