{
"k": "1355",
"who": "BIGBY",
"ctx": "Fables101/env_alleychase",
"en": "Bullshit! You're covered in blood!"
},
{
"k": "1356",
"who": "BIGBY",
"ctx": "Fables101/env_alleychase",
"en": "[pickup4] Questioning."
},
{
"k": "1357",
"who": "DEE",
"ctx": "Fables101/env_alleychase",
"en": "[pickup4] What? Why?"
},
{
"k": "1358",
"who": "BIGBY",
"ctx": "Fables101/env_alleychase",
"en": "[pickup4] Come on. I'm bringing you in."
},
