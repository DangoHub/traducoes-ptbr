"k": "1372",
"who": "BIGBY",
"ctx": "Fables101/env_alleychase",
"en": "[pickup4] Yup."
},
{
"k": "1373",
"who": "",
"ctx": "Fables101/env_alleychase",
"en": "Where did they go?"
},
{
"k": "1374",
"who": "",
"ctx": "Fables101/env_alleychase",
"en": "Just leave me here."
},
{
"k": "1375",
"who": "SNOW",
