[
{
"k": "4795",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Dammit. Well... where the hell did you come from, then?"
},
{
"k": "4796",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Is that a flower petal?"
},
{
"k": "4797",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Is that yours?"
},
{
"k": "4798",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Don't step over there."
},
{
"k": "4799",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Beauty's?"
},
{
"k": "4800",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Touch"
},
{
"k": "4801",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] Prints are pretty small."
},
{
"k": "4802",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "SNOW"
},
{
"k": "4803",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Hm?"
},
{
"k": "4804",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Bigby… hey."
},
{
"k": "4805",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yeah. Okay."
},
{
"k": "4806",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I just need you to answer a few questions."
},
{
"k": "4807",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "You okay, Beauty?"
},
{
"k": "4808",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yeah, thanks. I'm... I'm fine."
},
{
"k": "4809",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Want to call your husband?"
},
{
"k": "4810",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "You want me to call Beast?"
},
{
"k": "4811",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "No, no. That's okay. I don't want to wake him."
},
{
"k": "4812",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "He might already be awake."
},
{
"k": "4813",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Just the facts"
},
{
"k": "4814",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "What are you doing out this late?"
},
{
"k": "4815",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] Well. I went for a walk. {suspiciousa}I don't see what's wrong with that..."
},
{
"k": "4816",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Didn't say there was."
},
{
"k": "4817",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I understand."
},
{
"k": "4818",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'm sure this is the last place you want to be, but I've got to ask you a few questions before I can let you go."
},
{
"k": "4819",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "You need to answer a couple questions before I let you go."
},
{
"k": "4820",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Doesn't sound like I have a choice."
},
{
"k": "4821",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Just... like this. I didn't touch anything. I saw it and ran and got Snow."
},
{
"k": "4822",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "So, how did you find... her?"
},
{
"k": "4823",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "No. Not that I know of. There wasn't anyone on the street. [she thinks for a second] I mean, maybe a cab went by. I can't really be sure. Sorry."
},
{
"k": "4824",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Did you see anyone leaving?"
},
{
"k": "4825",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Bigby, I don't need to look over there to see her face. I don't know her. Sorry."
},
{
"k": "4826",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I've never seen her."
},
{
"k": "4827",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Do you know this woman?"
},
{
"k": "4828",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Look at her again."
},
{
"k": "4829",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Does Beast know where you are?"
},
{
"k": "4830",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yes, of course."
},
{
"k": "4831",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Beast told me you left"
},
{
"k": "4832",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "She's acting strange."
},
{
"k": "4833",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I spoke with Beast earlier."
},
{
"k": "4834",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Thanks for your time."
},
{
"k": "4835",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Thanks for your time. I'm sure this was hard for you."
},
{
"k": "4836",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I don't know what you're getting at."
},
{
"k": "4837",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Can I go now?"
},
{
"k": "4838",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I really don't like how this went. If this is how it goes when someone does the right thing, I understand why people don't even bother. Good night."
},
{
"k": "4839",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yeah. Don't leave town."
},
{
"k": "4840",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yeah. Don't mention this to anyone yet."
},
{
"k": "4841",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Not anyone, Beauty. Not even Beast."
},
{
"k": "4842",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I understand... Find this guy, Bigby."
},
{
"k": "4843",
"who": "BEAUTY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'm going… I need a drink... to settle my nerves. Goodnight, Snow."
},
{
"k": "4844",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Do anything stupid and I'll throw you down the Witching Well myself."
},
{
"k": "4845",
"who": "WOODSMAN",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Alright"
},
{
"k": "4846",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "What is..."
},
{
"k": "4847",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[remembering]Her ribbon."
},
{
"k": "4848",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Gate Lock"
},
{
"k": "4849",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Plastic bag"
},
{
"k": "4850",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Flower Bed"
},
{
"k": "4851",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Footprint"
},
{
"k": "4852",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Petal"
},
{
"k": "4853",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Do you have to tell him? No one knows about this yet. Maybe we hold off until we get a better handle on this."
},
{
"k": "4854",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "As long as King Cole is gone he's in charge."
},
{
"k": "4855",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "If he found out I knew and didn't tell him, it'd just be worse."
},
{
"k": "4856",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Tell him I'm on it. I'm not sure how much help that'll be, but we'll get whoever did this. I can promise you that."
},
{
"k": "4857",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "So who else can he blame?"
},
{
"k": "4858",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "He can't possibly blame you for this."
},
{
"k": "4859",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "With King Cole gone, Crane is in charge, and he'll be worried about protecting his own ass as usual."
},
{
"k": "4860",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Whoever did this."
},
{
"k": "4861",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "How about the son of a bitch who did this?"
},
{
"k": "4862",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Himself"
},
{
"k": "4863",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "He's the Deputy Mayor! Tell him to shove it. Blaming you is bullshit."
},
{
"k": "4864",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I guess.."
},
{
"k": "4865",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[shrug]You're right. Shit rolls downhill."
},
{
"k": "4866",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[embarrassed]Sorry."
},
{
"k": "4867",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Yes. I'm fine. [takes a breath] I'm just trying to figure out what I'm going to tell Crane."
},
{
"k": "4868",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Do you have to tell him?"
},
{
"k": "4869",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Tell him I'm on it."
},
{
"k": "4870",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "He can't possibly blame you."
},
{
"k": "4871",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "With King Cole gone, he's in charge, and this happened on our watch."
},
{
"k": "4872",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'm glad you're on this."
},
{
"k": "4873",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "You can count on me."
},
{
"k": "4874",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I know."
},
{
"k": "4875",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'll do my best."
},
{
"k": "4876",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Let's just get this guy."
},
{
"k": "4877",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'm really not sure how much time we have."
},
{
"k": "4878",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Damn..."
},
{
"k": "4879",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Either something very sharp, or something with magic attached to it."
},
{
"k": "4880",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5]Strange cut... what did this to her?"
},
{
"k": "4881",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "What could do something like that?"
},
{
"k": "4882",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] That was a long time ago..."
},
{
"k": "4883",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] Possibly... I remember it being pretty clean when he cut me open..."
},
{
"k": "4884",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Could The Woodsman's axe have done this?"
},
{
"k": "4885",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] There's not much blood."
},
{
"k": "4886",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup5] Hmmm. . ."
},
{
"k": "4887",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Clean. So, they didn't just dump you here."
},
{
"k": "4888",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Look how her head was set down... perfectly balanced. Not a hair out of place. Now, obviously someone wanted us to find her and cared how she looked when we did."
},
{
"k": "4889",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "She was placed here with some care."
},
{
"k": "4890",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "That's... odd... [shudders] I'm sorry. It's hard to look at."
},
{
"k": "4891",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]C'mon Snow.  Are you gonna talk to me at all?  Why the hell did you drag me down to the Woodlands at 5:30 in the morning?"
},
{
"k": "4892",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]It's Beauty."
},
{
"k": "4893",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Who's sitting over there?"
},
{
"k": "4894",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Who found her?"
},
{
"k": "4895",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I'll explain more when we get inside.  We don't have much time.  [frustrated at rusty lock]Stuck..."
},
{
"k": "4896",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]We just don't have much time.  [struggling with rusty lock]Damn this thing!"
},
{
"k": "4897",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][scared]Is... she's not a Mundy... right?"
},
{
"k": "4898",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]So... Who found her?"
},
{
"k": "4899",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][gentle, assuming Bigby is shocked]It's a shock... I know."
},
{
"k": "4900",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Yes, and I'm worried when they find out, there's going to be a panic inside."
},
{
"k": "4901",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Fables don't usually murder each other."
},
{
"k": "4902",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Well... Trusty John.   He's our new doorman."
},
{
"k": "4903",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Don't know enough yet."
},
{
"k": "4904",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Keep it quiet?  You mean sweep it under the rug."
},
{
"k": "4905",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Glad to hear you agree, Bigby. I was losing my mind with worry..."
},
{
"k": "4906",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Yeah.  No one else needs to know right now."
},
{
"k": "4907",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I wish you could.  I'm going out of my mind with worry."
},
{
"k": "4908",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I really don't know enough yet, Snow.  I can't make any promises."
},
{
"k": "4909",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]A little reassurance would go a long way right now, Bigby."
},
{
"k": "4910",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Take the gate.  We can't have people coming in from outside, either."
},
{
"k": "4911",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Okay.  What are you going to do?"
},
{
"k": "4912",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Cover it up"
},
{
"k": "4913",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Look for evidence"
},
{
"k": "4914",
"who": "",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "Talk to Beauty"
},
{
"k": "4915",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I'm going to use it to cover up this crime scene."
},
{
"k": "4916",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]We got thirty minutes?"
},
{
"k": "4917",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I'm gonna use it to look for evidence, before this place gets trampled."
},
{
"k": "4918",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "I'm gonna use it to talk to my witness.  She's the only one who might be able to tell me how this happened."
},
{
"k": "4919",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Well, I'll leave you to it.  But hurry."
},
{
"k": "4920",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][very genuine]Bigby, I'm sorry."
},
{
"k": "4921",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][gentle]Don't be.  I'm the one you should call.  It's my job."
},
{
"k": "4922",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][gentle]Beauty, are you alright?"
},
{
"k": "4923",
"who": "SNOW",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Regardless, they'll all be awake and down here soon."
},
{
"k": "4924",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]I'd say it's been here... an hour maybe?"
},
{
"k": "4925",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][alt]I'd say it's been here... a couple hours maybe?"
},
{
"k": "4926",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2][alt]I'd say it's been here... less than an hour maybe?"
},
{
"k": "4927",
"who": "BIGBY",
"ctx": "Fables101/env_fabletownwoodlandbuilding",
"en": "[pickup2]Blood.  [refining it]Drops of blood."
},
{
"k": "4928",
"who": "SNOW",
