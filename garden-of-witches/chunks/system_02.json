  "k": "Weapon_Info||Weapon.Scissor.0",
  "en": "When used, deals damage to all enemies in range. The final attack in the `Combo` is a Critical Hit."
 },
 {
  "k": "Weapon_Info||Weapon.Scissor.1",
  "en": "When used, deals damage to all enemies in range. The final attack in the `Combo` is a Critical Hit."
 },
 {
  "k": "Weapon_Info||Weapon.Scissor.2",
  "en": "When `Charge` ends, gathers and fires a number of projectiles equal to the `Charge Level`. The projectiles deal damage to every enemy they pierce. If charged to `Level 1` or higher, they land as Critical Hits."
 },
 {
  "k": "Weapon_Info||Weapon.Scissor.3",
  "en": "When used, deals damage to all enemies in range. Hits grant `Sharpness`. When `Sharpness` reaches `100%`, all attacks become Critical Hits."
 },
 {
  "k": "Weapon_Info||Weapon.Scissor.4",
  "en": "When used, loads projectiles and fires them one at a time at the `Strongest Enemy`, dealing damage to all enemies in range. After a set number of shots, the next projectile is a Critical Hit."
 },
 {
  "k": "Weapon_Info||Weapon.Scissor.5",
  "en": "When `Charge` ends, deals damage to all enemies in range once per `Charge Level`. If charged to `Level 1` or higher, the hits are Critical Hits."
 }
